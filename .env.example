# 本文件汇总前后端常用环境变量，便于本地或 Docker 一次性配置。
# 前端请同时参考 Media-Vue/.env.example；后端请参考 Media-Service/.env.example。

# ---------- 后端 Media-Service ----------
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:sqlite:media_manager.db
MEDIA_SYSTEM=linux
MEDIA_SECRET_STRING=please-change-this-jwt-secret-key
MEDIA_INITIAL_ACCOUNT=root
MEDIA_INITIAL_PASSWORD=please-change-this-password
MEDIA_INITIAL_NICKNAME=Admin

# ---------- 前端 Media-Vue ----------
VITE_DEV_PORT=80
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_FILE_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api
VITE_FILE_URL_PREFIX=
