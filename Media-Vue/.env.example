# 复制为 .env 或 .env.local 后按需修改。Vite 会自动加载以 VITE_ 开头的变量。

# 开发服务器端口
VITE_DEV_PORT=80

# 后端 API 代理目标（仅开发环境 Vite 使用）
VITE_API_PROXY_TARGET=http://localhost:8080

# 媒体文件 /content 代理目标（仅开发环境 Vite 使用）
# 不填写时默认与 VITE_API_PROXY_TARGET 相同
VITE_FILE_PROXY_TARGET=http://localhost:8080

# 前端请求的 API 前缀
VITE_API_BASE_URL=/api

# 媒体文件访问前缀。留空表示与页面同源
# 开发环境可走 Vite 的 /content 代理；生产环境建议由 Nginx 同域反代
# 若媒体由独立域名或 IP 提供，填写完整地址，例如 http://192.168.1.10
VITE_FILE_URL_PREFIX=
