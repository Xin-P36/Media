# 复制为 .env 后按需修改。Spring Boot 不会自动加载 .env，
# 启动前请先导出这些变量，或使用 Docker --env-file / docker compose。

# 服务端口
SERVER_PORT=8080

# SQLite 数据库路径（相对进程工作目录）
SPRING_DATASOURCE_URL=jdbc:sqlite:media_manager.db
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# 运行系统：linux 或 windows（影响 FFmpeg 命令调用方式）
MEDIA_SYSTEM=linux

# JWT 签名密钥，生产环境必须替换为足够长的随机字符串（建议 >= 32 字符）
MEDIA_SECRET_STRING=please-change-this-jwt-secret-key

# 仅在首次创建数据库时生效，用于初始化管理员账号
MEDIA_INITIAL_ACCOUNT=root
MEDIA_INITIAL_PASSWORD=please-change-this-password
MEDIA_INITIAL_NICKNAME=Admin
